# FeedEcho hosted mode — copy to .env (chmod 600) and fill in real values.
# Never commit the real .env.

# Multi-tenant mode. The app hard-fails at startup without a database URL
# and a strong session secret when this is set.
FEEDCHO_MODE=multi

# Public base URL, used for Mastodon OAuth callbacks.
FEEDCHO_BASE_URL=https://feedecho.net

# Session-signing secret: >= 32 chars of random data. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FEEDCHO_SESSION_SECRET=change-me-to-a-long-random-string

# Postgres credentials (the app connects over the compose network).
# Use URL-safe characters only: the password is interpolated directly
# into FEEDCHO_DATABASE_URL in the compose file. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=feedecho
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=feedecho

# Domain Caddy serves and provisions TLS for (defaults to feedecho.net
# in the Caddyfile when unset).
FEEDECHO_DOMAIN=feedecho.net

# Caddy terminates TLS; the app sees http and must force Secure cookies.
FEEDCHO_FORCE_SECURE_COOKIE=1

# Trusted proxy CIDRs (the dedicated compose network where Caddy runs).
FEEDCHO_TRUSTED_PROXIES=172.28.0.0/16

# ACME contact for Let's Encrypt certificate notices.
ACME_EMAIL=you@example.com
