# FeedEcho hosted stack — reverse proxy config
# TLS certificates are provisioned automatically (Let's Encrypt).
# {$ACME_EMAIL} and {$FEEDECHO_DOMAIN} come from the caddy service's
# environment (compose passes them through from .env).

{
    email {$ACME_EMAIL}
}

{$FEEDECHO_DOMAIN:feedecho.net} {
    reverse_proxy feedecho:8453
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
}
